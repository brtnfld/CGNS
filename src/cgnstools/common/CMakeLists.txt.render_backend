# Render Backend Library CMake Configuration
#
# This creates the cgns_render_backend library that provides abstraction
# over OpenGL (legacy) and bgfx (modern) rendering APIs.
#
# Options:
#   CGNS_RENDER_BACKEND - Select default backend (OPENGL or BGFX)
#   CGNS_ENABLE_BGFX    - Enable bgfx backend support

# ========================================================================
# Configuration Options
# ========================================================================

# Default to OpenGL backend (maximum compatibility)
set(CGNS_RENDER_BACKEND "OPENGL" CACHE STRING
    "Default rendering backend (OPENGL or BGFX)")
set_property(CACHE CGNS_RENDER_BACKEND PROPERTY STRINGS OPENGL BGFX)

# Option to enable bgfx support (disabled by default for Phase 1)
option(CGNS_ENABLE_BGFX "Enable bgfx rendering backend" OFF)

# ========================================================================
# Source Files
# ========================================================================

set(RENDER_BACKEND_SOURCES
    render_backend_opengl.c
)

set(RENDER_BACKEND_HEADERS
    render_backend.h
)

# Add bgfx backend if enabled
if(CGNS_ENABLE_BGFX)
    list(APPEND RENDER_BACKEND_SOURCES render_backend_bgfx.c)
    message(STATUS "bgfx rendering backend: ENABLED")
else()
    message(STATUS "bgfx rendering backend: DISABLED (Phase 1)")
endif()

# ========================================================================
# Library Target
# ========================================================================

add_library(cgns_render_backend STATIC
    ${RENDER_BACKEND_SOURCES}
    ${RENDER_BACKEND_HEADERS}
)

# ========================================================================
# Include Directories
# ========================================================================

target_include_directories(cgns_render_backend PUBLIC
    ${CMAKE_CURRENT_SOURCE_DIR}
)

# OpenGL is always needed (even bgfx can use it as backend)
if(NOT APPLE)
    find_package(OpenGL REQUIRED)
    target_include_directories(cgns_render_backend PUBLIC
        ${OPENGL_INCLUDE_DIR}
    )
    target_link_libraries(cgns_render_backend PUBLIC
        OpenGL::GL
        OpenGL::GLU
    )
else()
    # macOS OpenGL paths
    target_include_directories(cgns_render_backend PUBLIC
        ${X11_GL_INCLUDE_PATH}
    )
    target_link_libraries(cgns_render_backend PUBLIC
        ${X11_GL_LIB}
        ${X11_GLU_LIB}
    )
endif()

# ========================================================================
# bgfx Integration (Phase 2)
# ========================================================================

if(CGNS_ENABLE_BGFX)
    # Check if bgfx is in external directory
    get_filename_component(CGNS_SOURCE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/../../.." ABSOLUTE)
    set(BGFX_EXTERNAL_DIR "${CGNS_SOURCE_ROOT}/external")

    if(EXISTS "${BGFX_EXTERNAL_DIR}/bgfx/include/bgfx/bgfx.h")
        message(STATUS "Found bgfx in external directory: ${BGFX_EXTERNAL_DIR}")

        # Check if bgfx.cmake exists (CMake-based build)
        if(EXISTS "${BGFX_EXTERNAL_DIR}/bgfx.cmake")
            message(STATUS "Using CMake-based bgfx build from source")
            include("${BGFX_EXTERNAL_DIR}/bgfx.cmake")

            # Link CMake-built bgfx libraries
            target_link_libraries(cgns_render_backend PUBLIC
                bgfx
                bimg
                bx
            )

            # Add bgfx include paths (already set by bgfx.cmake, but ensure C99 API is included)
            target_include_directories(cgns_render_backend PUBLIC
                ${BGFX_EXTERNAL_DIR}/bgfx/include
                ${BGFX_EXTERNAL_DIR}/bgfx/include/../bindings/c
                ${BGFX_EXTERNAL_DIR}/bx/include
                ${BGFX_EXTERNAL_DIR}/bimg/include
            )

            # Enable bgfx backend
            target_compile_definitions(cgns_render_backend PUBLIC CGNS_ENABLE_BGFX)

            message(STATUS "bgfx backend enabled successfully (CMake build)")
        else()
            # Fall back to pre-built library search
            # Add bgfx include paths
            target_include_directories(cgns_render_backend PUBLIC
                ${BGFX_EXTERNAL_DIR}/bgfx/include
                ${BGFX_EXTERNAL_DIR}/bx/include
                ${BGFX_EXTERNAL_DIR}/bimg/include
            )

            # Determine platform-specific library paths
            if(APPLE)
                # macOS: Check for both ARM64 and x86_64 builds
                find_library(BGFX_LIBRARY NAMES bgfx bgfxRelease
                    PATHS
                        ${BGFX_EXTERNAL_DIR}/bgfx/.build/osx-arm64/bin
                        ${BGFX_EXTERNAL_DIR}/bgfx/.build/osx64_clang/bin
                    NO_DEFAULT_PATH)
                find_library(BX_LIBRARY NAMES bx bxRelease
                    PATHS
                        ${BGFX_EXTERNAL_DIR}/bgfx/.build/osx-arm64/bin
                        ${BGFX_EXTERNAL_DIR}/bgfx/.build/osx64_clang/bin
                    NO_DEFAULT_PATH)
                find_library(BIMG_LIBRARY NAMES bimg bimgRelease
                    PATHS
                        ${BGFX_EXTERNAL_DIR}/bgfx/.build/osx-arm64/bin
                        ${BGFX_EXTERNAL_DIR}/bgfx/.build/osx64_clang/bin
                    NO_DEFAULT_PATH)
                find_library(BIMG_DECODE_LIBRARY NAMES bimg_decode bimg_decodeRelease
                    PATHS
                        ${BGFX_EXTERNAL_DIR}/bgfx/.build/osx-arm64/bin
                        ${BGFX_EXTERNAL_DIR}/bgfx/.build/osx64_clang/bin
                    NO_DEFAULT_PATH)
            else()
                # Linux
                find_library(BGFX_LIBRARY NAMES bgfx bgfxRelease
                    PATHS ${BGFX_EXTERNAL_DIR}/bgfx/.build/linux64_gcc/bin
                    NO_DEFAULT_PATH)
                find_library(BX_LIBRARY NAMES bx bxRelease
                    PATHS ${BGFX_EXTERNAL_DIR}/bgfx/.build/linux64_gcc/bin
                    NO_DEFAULT_PATH)
                find_library(BIMG_LIBRARY NAMES bimg bimgRelease
                    PATHS ${BGFX_EXTERNAL_DIR}/bgfx/.build/linux64_gcc/bin
                    NO_DEFAULT_PATH)
                find_library(BIMG_DECODE_LIBRARY NAMES bimg_decode bimg_decodeRelease
                    PATHS ${BGFX_EXTERNAL_DIR}/bgfx/.build/linux64_gcc/bin
                    NO_DEFAULT_PATH)
            endif()

            if(BGFX_LIBRARY AND BX_LIBRARY AND BIMG_LIBRARY)
                # Link pre-built bgfx libraries
                target_link_libraries(cgns_render_backend PUBLIC
                    ${BGFX_LIBRARY}
                    ${BIMG_DECODE_LIBRARY}
                    ${BIMG_LIBRARY}
                    ${BX_LIBRARY}
                )

                if(NOT APPLE)
                    target_link_libraries(cgns_render_backend PUBLIC
                        stdc++
                        dl
                        pthread
                    )
                endif()

                # Enable bgfx backend
                target_compile_definitions(cgns_render_backend PUBLIC CGNS_ENABLE_BGFX)

                message(STATUS "bgfx backend enabled successfully (pre-built)")
                message(STATUS "  - bgfx library: ${BGFX_LIBRARY}")
                message(STATUS "  - bx library: ${BX_LIBRARY}")
                message(STATUS "  - bimg library: ${BIMG_LIBRARY}")
            else()
                message(WARNING "bgfx/bx/bimg libraries not found.")
                message(WARNING "Option 1: Use CMake build (recommended) - copy bgfx.cmake to ${BGFX_EXTERNAL_DIR}/")
                if(APPLE)
                    message(WARNING "Option 2: Build manually - cd ${BGFX_EXTERNAL_DIR}/bgfx && make osx-arm64-release")
                else()
                    message(WARNING "Option 2: Build manually - cd ${BGFX_EXTERNAL_DIR}/bgfx && make linux-release64")
                endif()
                set(CGNS_ENABLE_BGFX OFF CACHE BOOL "Enable bgfx backend" FORCE)
            endif()
        endif()

    else()
        message(WARNING "bgfx not found in ${BGFX_EXTERNAL_DIR}")
        message(WARNING "To enable bgfx:")
        message(WARNING "  1. cd ${CGNS_SOURCE_ROOT}/external")
        message(WARNING "  2. git clone --depth 1 https://github.com/bkaradzic/bx.git")
        message(WARNING "  3. git clone --depth 1 https://github.com/bkaradzic/bimg.git")
        message(WARNING "  4. git clone --depth 1 https://github.com/bkaradzic/bgfx.git")
        message(WARNING "  5. Re-run cmake")
        set(CGNS_ENABLE_BGFX OFF CACHE BOOL "Enable bgfx backend" FORCE)
    endif()
endif()

# ========================================================================
# Compiler Definitions
# ========================================================================

# Set default backend
if(CGNS_RENDER_BACKEND STREQUAL "BGFX")
    if(NOT CGNS_ENABLE_BGFX)
        message(WARNING "BGFX backend selected but not enabled, falling back to OpenGL")
        set(CGNS_RENDER_BACKEND "OPENGL" CACHE STRING "Default rendering backend" FORCE)
    else()
        target_compile_definitions(cgns_render_backend PUBLIC
            CGNS_DEFAULT_BACKEND_BGFX
        )
    endif()
else()
    target_compile_definitions(cgns_render_backend PUBLIC
        CGNS_DEFAULT_BACKEND_OPENGL
    )
endif()

message(STATUS "Default rendering backend: ${CGNS_RENDER_BACKEND}")

# ========================================================================
# Installation
# ========================================================================

install(TARGETS cgns_render_backend
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
)

install(FILES ${RENDER_BACKEND_HEADERS}
    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/cgnstools
)

# ========================================================================
# Test Executables
# ========================================================================

# Optional test programs
option(CGNS_BUILD_RENDER_TESTS "Build render backend test programs" ON)

if(CGNS_BUILD_RENDER_TESTS)
    # Simple bgfx backend test (headless)
    if(CGNS_ENABLE_BGFX)
        add_executable(test_bgfx_simple test_bgfx_simple.c)
        target_link_libraries(test_bgfx_simple PRIVATE cgns_render_backend m)

        # Add test to CTest if enabled
        if(BUILD_TESTING)
            add_test(NAME test_bgfx_simple COMMAND test_bgfx_simple)
        endif()

        message(STATUS "bgfx test program: test_bgfx_simple")
    endif()
endif()

# ========================================================================
# Summary
# ========================================================================

message(STATUS "===== Render Backend Configuration =====")
message(STATUS "  OpenGL support: ENABLED (always)")
message(STATUS "  bgfx support:   ${CGNS_ENABLE_BGFX}")
message(STATUS "  Default backend: ${CGNS_RENDER_BACKEND}")
message(STATUS "  Build tests:    ${CGNS_BUILD_RENDER_TESTS}")
message(STATUS "========================================")
